{
  "name": "practicesoftwaretesting-cypress",
  "version": "2.0.0",
  "description": "Cypress E2E test suite for practicesoftwaretesting.com — Part 1 & Part 2",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:part1": "cypress run --spec 'cypress/e2e/practicesoftwaretesting.cy.js'",
    "test:pom": "cypress run --spec 'cypress/e2e/practicesoftwaretesting.pom.cy.js'",
    "test:bdd": "cypress run --spec 'cypress/e2e/features/**/*.feature'",
    "test:all": "cypress run",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "*",
    "@bahmutov/cypress-esbuild-preprocessor": "*",
    "cypress": "^15.15.0",
    "esbuild": "*"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.steps.js",
    "cucumberJson": {
      "generate": true,
      "outputFolder": "cypress/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".cucumber"
    }
  }
}
